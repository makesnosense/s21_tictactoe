meta {
  name: refresh
  type: http
  seq: 3
}

post {
  url: http://localhost:3000/api/auth/refresh
  body: json
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

script:post-response {
  const response = res.getBody();
  if (response && response.accessToken) {
    bru.setVar("accessToken", response.accessToken);
    bru.setVar("refreshToken", response.refreshToken);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
