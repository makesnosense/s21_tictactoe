meta {
  name: my-active-game
  type: http
  seq: 5
}

get {
  url: http://localhost:3000/api/games-vs-human/my-active-game
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "login": "meow",
    "password": "meowmeow"
  }
}

script:post-response {
  const game = res.getBody();
  if (game) {
    bru.setVar("gameId", game.id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
