meta {
  name: make-move-first-player
  type: http
  seq: 7
}

post {
  url: http://localhost:3000/api/games-vs-human/{{gameId}}/move
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
  "board": [[1,0,0],
            [0,0,0],
            [0,0,0]]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
