meta {
  name: my-history
  type: http
  seq: 6
}

get {
  url: http://localhost:3000/api/games-vs-human/my-history
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "login": "meow",
    "password": "meowmeow"
  }
}

script:post-response {
  const games = res.getBody();
  if (games && games.length > 0) {
    bru.setVar("gameId", games[0].id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
