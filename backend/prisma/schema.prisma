generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  username String @unique
  password String

  @@map("users")
}

model Game {
  slot        Int     @id // slot-based ID system
  board       Json // CellValue[][] stored as JSON
  status      String // "player_turn" | "computer_turn" | "finished"
  winner      String? // "draw" | "player wins" | "computer wins" | null
  winningLine Json? // { start: {row, col}, end: {row, col} } | null

  @@map("games_vs_computer")
}

model GameVsHuman {
  id              String   @id @default(uuid()) @db.Uuid
  board           Json
  status          String
  playerOneId     String   @db.Uuid
  playerTwoId     String?  @db.Uuid
  playerOneSymbol Int
  playerTwoSymbol Int
  winner          String?
  winnerId        String?  @db.Uuid
  winningLine     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("games_vs_human")
}
